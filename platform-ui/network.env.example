# Compose overlay inputs; keep render's strict base env in a separate file.
# Give each runtime role its own project, network names/subnets and state volumes.
AELEV_INFRASTRUCTURE_PLATFORM_UI_API_BIND=127.0.0.1
AELEV_INFRASTRUCTURE_PLATFORM_UI_API_PORT=18444
AELEV_INFRASTRUCTURE_PLATFORM_UI_UI_API_PROBE_URL=https://api.platform.example:18444/api/readyz
# Role-local render example; the identity is supplied by this owner's PKI policy:
# prepare.py render --env BASE_ENV --role nginx --api-url https://api.platform.example:18444 --proxy-spiffe-id spiffe://platform.example/ui/nginx
# For an IP route, additionally pass the certificate's DNS name with --api-tls-name.
