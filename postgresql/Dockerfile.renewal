FROM python:3.13.7-alpine3.22@sha256:9ba6d8cbebf0fb6546ae71f2a1c14f6ffd2fdab83af7fa5669734ef30ad48844
COPY renewal.py /opt/aelev/sql-client-renewal.py
COPY vendor/aelev-renewal-delivery-1.0.0.zip /opt/aelev/vendor/aelev-renewal-delivery-1.0.0.zip
LABEL io.aelev.postgresql.certificate-delivery="1"
LABEL io.aelev.renewal.helper-update="1"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python", "/opt/aelev/sql-client-renewal.py"]
