FROM docker:28.5.1-cli@sha256:9190b0613792e658a7783cf14b2d5ace5941bb68ede7276922ea36ee457d76ad AS docker-cli
FROM python:3.13.7-slim-bookworm@sha256:adafcc17694d715c905b4c7bebd96907a1fd5cf183395f0ebc4d3428bd22d92d
LABEL org.opencontainers.image.title="DRP bounded recovery operator" \
    org.opencontainers.image.source="https://github.com/sapogov1978/discovery-research-platform" \
    io.aelev.recovery.operator="1" \
    io.aelev.recovery.host-interface="2" \
    io.aelev.recovery.automatic-recovery="1"
LABEL io.aelev.recovery.registration="1"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /opt/aelev-recovery
COPY recovery.py recovery_cli.py recovery_host.py ./
RUN sha256sum recovery.py > recovery.sha256
# The bootstrap selects the existing journal owner's numeric UID/GID.
# No daemon, timer or reset is installed in this container adapter.
ENTRYPOINT ["python", "-S", "/opt/aelev-recovery/recovery_cli.py"]
