# Overlay onto the owner's deployment env; not a secret store.
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_MODE=kubernetes
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_TIMEOUT_SECONDS=20
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_PORT=19443
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_MEMORY=128Mi
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_KUBERNETES_API=https://kubernetes.default.svc
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_KUBERNETES_NAMESPACE=aelev-postgresql
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_KUBERNETES_SECRET_PROVIDER_CLASS=postgresql-fencing
AELEV_INFRASTRUCTURE_POSTGRESQL_FENCING_KUBERNETES_STORAGE_CLASS=standard
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_1_KUBERNETES_POD=postgresql-1-0
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_2_KUBERNETES_POD=postgresql-2-0
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_3_KUBERNETES_POD=postgresql-3-0
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_1_FENCING_URL=https://postgresql-fencer:19443
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_2_FENCING_URL=https://postgresql-fencer:19443
AELEV_INFRASTRUCTURE_POSTGRESQL_NODE_3_FENCING_URL=https://postgresql-fencer:19443
