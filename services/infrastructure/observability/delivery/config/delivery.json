{
  "mode": "archive",
  "listen_host": "0.0.0.0",
  "listen_port": 4318,
  "health_port": 13134,
  "journal": "/var/lib/delivery",
  "capacity_bytes": "${AELEV_INFRASTRUCTURE_DELIVERY_CAPACITY_BYTES}",
  "request_bytes": "${AELEV_INFRASTRUCTURE_DELIVERY_REQUEST_BYTES}",
  "retry_seconds": "${AELEV_INFRASTRUCTURE_DELIVERY_RETRY_SECONDS}",
  "timeout_seconds": "${AELEV_INFRASTRUCTURE_DELIVERY_TIMEOUT_SECONDS}",
  "server_cert": "/run/secrets/observability/server.crt",
  "server_key": "/run/secrets/observability/server.key",
  "client_ca": "/run/secrets/observability/publisher-ca.crt",
  "ca": "/run/secrets/observability/ca.crt",
  "client_cert": "/run/secrets/observability/client.crt",
  "client_key": "/run/secrets/observability/client.key",
  "health_ca": "/run/secrets/observability/ca.crt",
  "health_cert": "/run/secrets/observability/client.crt",
  "health_key": "/run/secrets/observability/client.key",
  "destinations": {
    "logs": "${AELEV_INFRASTRUCTURE_DELIVERY_LOGS_URL}",
    "traces": "${AELEV_INFRASTRUCTURE_DELIVERY_TRACES_URL}",
    "metrics": "${AELEV_INFRASTRUCTURE_DELIVERY_METRICS_URL}",
    "otlp_metrics": "${AELEV_INFRASTRUCTURE_DELIVERY_OTLP_METRICS_URL}"
  },
  "prometheus_command": []
}
