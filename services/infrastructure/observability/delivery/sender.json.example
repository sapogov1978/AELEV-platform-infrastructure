{
  "mode": "sender",
  "listen_host": "0.0.0.0",
  "listen_port": 4318,
  "health_port": 13134,
  "journal": "/var/lib/delivery",
  "capacity_bytes": 10737418240,
  "request_bytes": 4194304,
  "retry_seconds": 5,
  "timeout_seconds": 10,
  "server_cert": "/run/secrets/telemetry/server.crt",
  "server_key": "/run/secrets/telemetry/server.key",
  "client_ca": "/run/secrets/telemetry/local-publisher-ca.crt",
  "ca": "/run/secrets/telemetry/central-ca.crt",
  "client_cert": "/run/secrets/telemetry/client.crt",
  "client_key": "/run/secrets/telemetry/client.key",
  "health_ca": "/run/secrets/telemetry/local-query-ca.crt",
  "health_cert": "/run/secrets/telemetry/query-client.crt",
  "health_key": "/run/secrets/telemetry/query-client.key",
  "destinations": {
    "logs": "https://telemetry.example.invalid:4318/v1/logs",
    "traces": "https://telemetry.example.invalid:4318/v1/traces",
    "metrics": "https://telemetry.example.invalid:4318/api/v1/write",
    "otlp_metrics": "https://telemetry.example.invalid:4318/v1/metrics"
  },
  "prometheus_command": [
    "/bin/prometheus",
    "--config.file=/etc/aelev/prometheus.yml",
    "--web.config.file=/etc/aelev/web.yml",
    "--storage.tsdb.path=/var/lib/delivery/prometheus",
    "--storage.tsdb.retention.time=30d",
    "--log.format=json"
  ]
}
