      "keycloak-status-publisher",
      "loki",
      "loki-status-publisher",
      "minio-site-a-1",
      "minio-site-a-2",
      "minio-site-a-3",
      "minio-site-a-4",
      "minio-site-b-1",
      "minio-site-b-2",
      "minio-site-b-3",
