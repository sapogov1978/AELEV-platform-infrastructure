    "observability/tempo",
    "platform-ui",
    "postgresql",
    "public-egress-gateway",
    "spire",
    "translator-service"
  ],
  "environment_files": [
    ".env",
    "kafka/.env",
    "keycloak/.env",
    "minio/.env",
    "observability/.env",
    "observability/blackbox-exporter/.env",
    "observability/delivery/.env",
    "observability/grafana/.env",
    "observability/loki/.env",
    "observability/otel-collector/.env",
    "observability/prometheus/.env",
    "observability/tempo/.env",
    "platform-ui/.env",
    "postgresql/.env",
    "public-egress-gateway/.env",
    "spire/.env",
    "translator-service/.env"
  ],
  "external_inputs": [
    {
      "id": "translation-provider-image",
      "kind": "container-image-digest",
      "env_file": "translator-service/.env",
      "variable": "AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_IMAGE",
      "owner": "translation-provider",
      "source_repository": "https://github.com/sapogov1978/AELEV-translation-provider",
      "release_workflow": "release-provider-image",
      "release_run": "https://github.com/sapogov1978/AELEV-translation-provider/actions/runs/42248923795",
      "admitted_reference": "ghcr.io/sapogov1978/aelev-translation-provider@sha256:4a820a13e6a03188589c09d14e52b5f2d05e9359d7df847bad768966016e9ec9",
      "purpose": "Opaque translation capability provider; Translator does not inspect its implementation."
    },
    {
      "id": "translator-worker-image",
      "kind": "container-image-digest",
      "env_file": "translator-service/.env",
      "variable": "AELEV_INFRASTRUCTURE_TRANSLATOR_WORKER_IMAGE",
      "owner": "translator-service",
      "source_repository": "https://github.com/sapogov1978/AELEV-platform-infrastructure",
      "release_workflow": "release-translator-worker-image",
      "purpose": "Translator worker admitted independently from the opaque provider."
    },
    {
      "id": "spire-installer-approval",
      "kind": "operator-confirmation",
      "variable": "DRP_SPIRE_DOCKER_SOCKET_APPROVAL",
      "expected": "operator-root-equivalent-v1",
      "persistent": false,
      "owner": "operator",
      "purpose": "One-process approval for the SPIRE installer helper with Docker socket access."
    }
  ],
  "local_builds": [
    {
      "image": "aelev/infrastructure-spire:local",
      "context": "spire",
      "target": "runtime"
    },
    {
      "image": "aelev/infrastructure-spire-installer:local",
      "context": "spire",
      "target": "operator-installer"
    },
    {
      "image": "aelev/spire-telemetry-sender:local",
      "context": "spire",
      "target": "telemetry-sender"
    }
  ],
  "acceptance": {
    "runner": "test_infrastructure/clean_room_gate.py",
    "verifier": "test_infrastructure/clean_room.py",
    "required_functions": [
      "identity-login",
      "platform-ui-owner-status",
      "kafka-round-trip",
      "postgresql-transaction",
      "object-storage-round-trip",
      "public-egress-default-deny-and-exact-allow",
      "telemetry-delivery-query",
      "opaque-translation-round-trip",
      "workload-identity-issue-rotate-revoke",
      "workload-identity-observation-delivery-recovery",
      "bounded-recovery-preserves-state"
    ],
    "evidence_schema": "docs/schemas/clean-room-evidence-v1.json"
  }
}
