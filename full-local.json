  "compute_compose": {
    "file": "translator-service/compose.compute.yml",
    "env_file": "translator-service/.env",
    "required_services": [
      "translation-provider",
      "translator-worker"
    ]
  },
  "owners": [
    "kafka",
    "keycloak",
    "minio",
    "observability/blackbox-exporter",
    "observability/delivery",
    "observability/grafana",
    "observability/loki",
    "observability/otel-collector",
