# One worker replica placement. Its own keys are delivered on THIS node.
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_COMPOSE_PROJECT=translator-worker-primary
AELEV_INFRASTRUCTURE_TRANSLATOR_WORKER_IMAGE=REPLACE_WITH_ADMITTED_NETWORK_WORKER_IMAGE_BY_DIGEST
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_URL=https://REPLACE_WITH_ROUTED_PROVIDER_HOST:18487
AELEV_INFRASTRUCTURE_TRANSLATOR_WORKER_SVID_VOLUME=REPLACE_WITH_THIS_WORKER_SVID_VOLUME
AELEV_INFRASTRUCTURE_TRANSLATOR_WORKER_IDENTITY_POLICY=/REPLACE/worker/identity.json
AELEV_INFRASTRUCTURE_TRANSLATOR_ENVIRONMENT=production
AELEV_INFRASTRUCTURE_TRANSLATOR_SECRET_GID=10001
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_HOST=REPLACE_WITH_ROUTED_DATABASE_HOST
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_PORT=5432
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_NAME=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_USER=translator_service
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SSLMODE=verify-full
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CA_FILE=ca.crt
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_CERT_FILE=client.crt
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_CLIENT_KEY_FILE=client.key
AELEV_INFRASTRUCTURE_TRANSLATOR_DATABASE_SECRET_ROOT=/REPLACE/worker/database
AELEV_INFRASTRUCTURE_TRANSLATOR_OTLP_HTTP_ENDPOINT=https://REPLACE_WITH_ROUTED_TELEMETRY_SENDER:4318
AELEV_INFRASTRUCTURE_TRANSLATOR_TELEMETRY_SECRET_ROOT=/REPLACE/worker/telemetry
AELEV_INFRASTRUCTURE_TRANSLATOR_PRESENCE_INTERVAL_SECONDS=10
AELEV_INFRASTRUCTURE_TRANSLATOR_PRESENCE_TTL_SECONDS=30
AELEV_INFRASTRUCTURE_TRANSLATOR_HIGH_PRIORITY_BURST=4
AELEV_INFRASTRUCTURE_TRANSLATOR_ROLE_MEMORY_LIMIT=256m
AELEV_INFRASTRUCTURE_TRANSLATOR_ROLE_CPUS=0.25
AELEV_INFRASTRUCTURE_TRANSLATOR_RESTART_POLICY=on-failure:3
