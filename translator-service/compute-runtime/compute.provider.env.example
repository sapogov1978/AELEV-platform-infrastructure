# One node-local provider placement. Fill the NEW admitted mTLS release digest.
AELEV_INFRASTRUCTURE_TRANSLATOR_COMPUTE_COMPOSE_PROJECT=translator-provider-primary
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_IMAGE=REPLACE_WITH_ADMITTED_NETWORK_PROVIDER_IMAGE_BY_DIGEST
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_BIND_ADDRESS=0.0.0.0
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_PORT=18487
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_SVID_VOLUME=REPLACE_WITH_THIS_NODE_PROVIDER_SVID_VOLUME
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_IDENTITY_POLICY=/REPLACE/provider/identity.json
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_TRANSPORT_FILE=/REPLACE/provider/transport.json
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_SECRET_FILE=/REPLACE/provider/credential.env
AELEV_INFRASTRUCTURE_TRANSLATOR_SECRET_GID=10001
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_MEMORY_LIMIT=1g
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_CPUS=2
AELEV_INFRASTRUCTURE_TRANSLATOR_PROVIDER_RESTART_POLICY=on-failure:3
