.DS_Store
.env
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.tsbuildinfo
node_modules/
dist/
runtime/

# Model entry points are tracked; their downloaded runtime and private state are not.
/models/*/_files/python/
/models/*/_files/payload/
/models/*/_files/installer.py
/models/*/_files/package.json
/models/*/_files/package.pending
/models/*/_files/connection/
/models/*/_files/state/

# Materialized from checksum-pinned owner Dockerfile ADD instructions.
services/**/swagger-assets/

# Graphify local caches and machine-specific build state.
graphify-out/cache/
graphify-out/.graphify_build_state.json
graphify-out/.graphify_labels.pending.json
graphify-out/.graphify_labels.json.sig
