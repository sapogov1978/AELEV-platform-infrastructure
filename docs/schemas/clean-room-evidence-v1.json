{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sapogov1978/AELEV-platform-infrastructure/blob/main/docs/schemas/clean-room-evidence-v1.json",
  "title": "Platform Infrastructure clean-room evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "release",
    "source_commit",
    "bom_sha256",
    "started_at",
    "finished_at",
    "clean_baseline",
    "cleanup_preserved",
    "functions",
    "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "full-local"},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "bom_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "clean_baseline": {"const": true},
    "cleanup_preserved": {"const": true},
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {"const": "PASS"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "result": {"const": "PASS"}
  }
}
