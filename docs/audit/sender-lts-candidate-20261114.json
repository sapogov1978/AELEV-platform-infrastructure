    "scope": "unchanged declared owner sender profiles only; no blanket admission for arbitrary command/configuration or imported untrusted storage",
    "assessments": [
      {
        "ids": [
          "CVE-2026-78661",
          "CVE-2026-97045",
          "GO-2026-5932",
          "GO-2022-0635",
          "GO-2022-0646"
        ],
        "disposition": "NOT_AFFECTED_CODE_NOT_PRESENT",
        "basis": "Affected HTML parse/render, OpenPGP and AWS s3crypto packages are absent from both binaries on both architectures; module presence alone retained in raw reports."
      },
      {
        "ids": [
          "CVE-2026-84445"
        ],
        "disposition": "NOT_AFFECTED_REQUIRED_XDS_HANDLER_ABSENT",
        "basis": "grpc internal transport HandleStreams is linked, but internal/xds/server.RouteAndProcess is absent; the advisory requires an xDS routing interceptor."
      },
      {
        "ids": [
          "CVE-2026-97054"
        ],
        "disposition": "NOT_AFFECTED_IN_DECLARED_PROFILE",
        "basis": "Affected Go HTTP server is confined to container loopback with mTLS. Only Python ingestion/health are published; the health interface returns 404 for Go API paths. No public Go HTTP request-body handler is admitted."
      },
      {
        "ids": [
          "CVE-2026-116591"
        ],
        "disposition": "NOT_AFFECTED_IN_DECLARED_PROFILE",
        "basis": "Affected FSE/Huffman decode symbols are linked. Admitted WAL uses snappy, remote read is disabled, remote write uses prometheus.WriteRequest/snappy, scrape handles gzip rather than zstd, and the internal Go API is not published. Existing owner-local WAL is trusted state; arbitrary imported WAL and custom zstd profiles are excluded."
      },
      {
        "ids": [
          "CVE-2026-128085"
        ],
        "disposition": "NOT_AFFECTED_IN_DECLARED_PROFILE",
        "basis": "Tracing, OTLP receiver and auto-instrumentation are not enabled in the admitted owner profile; no untrusted attributes enter the affected recording/truncation path. This is not an admission of tracing-enabled profiles."
      },
      {
        "ids": [
          "GO-2026-5264",
          "GO-2026-5381",
          "GO-2026-5662"
        ],
        "disposition": "FIXED_UPSTREAM_VERSION_MAPPING",
        "basis": "Official release 3.13.5 maps to Go module 0.313.5 via the upstream get_module_version.sh. This exceeds the affected fixed-version boundaries; generated-build pseudo-version findings are retained."
      },
      {
        "ids": [
          "CVE-2025-8869",
          "CVE-2026-13346",
          "CVE-2026-3219",
          "CVE-2026-6357",
          "CVE-2026-8643",
          "CVE-2026-1703"
        ],
        "disposition": "NOT_AFFECTED_IN_SERVICE_EXECUTION_PROFILE",
        "basis": "pip remains installed and is reported verbatim. The admitted read-only, unprivileged service neither installs packages nor exposes package-manager execution; its only supervised executable is the pinned Prometheus. Operator-driven installation or modified commands require separate admission."
      }
    ],
