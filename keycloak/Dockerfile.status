ARG PYTHON_IMAGE=python:3.13.7-alpine3.22@sha256:9ba6d8cbebf0fb6546ae71f2a1c14f6ffd2fdab83af7fa5669734ef30ad48844
ARG SQLITE_IMAGE=ghcr.io/sapogov1978/aelev-platform-infrastructure-observability-sender@sha256:162f07e6fd043eb3d9e04e7c415bee07771321a6f7f3864fcba0ce1f80dd941e
FROM ${SQLITE_IMAGE} AS sqlite
FROM ${PYTHON_IMAGE} AS builder
RUN pip install --no-cache-dir poetry==2.2.1
WORKDIR /work
COPY pyproject.toml poetry.lock ./
COPY vendor ./vendor
RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
RUN poetry install --only main --no-interaction --no-ansi

FROM builder AS checks
COPY Dockerfile.status ./
RUN apk add --no-cache docker-cli docker-cli-compose
RUN poetry install --with dev --no-interaction --no-ansi
COPY status_publisher.py recovery.py migrate_password_files.py ./
COPY publisher_health_probe.py ./
COPY --from=builder /opt/venv/lib/python3.13/site-packages/aelev_platform_ui_client/health.py ./publisher_health.py
COPY compose.yml .env.example README.md Dockerfile .dockerignore keycloak-entrypoint.sh ./
COPY test ./test/
COPY themes ./themes/
COPY realm.json ./realm.json

FROM ${PYTHON_IMAGE} AS runtime
COPY --from=sqlite /usr/local/lib/libsqlite3.so.0 /usr/local/lib/libsqlite3.so.0
ENV LD_LIBRARY_PATH=/usr/local/lib
RUN python -S -c "import sqlite3; assert sqlite3.sqlite_version_info == (3, 53, 4), sqlite3.sqlite_version"
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/venv/lib/python3.13/site-packages/aelev_platform_ui_client/health.py /opt/keycloak-status/publisher_health.py
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /var/lib/keycloak-status && chown 101:101 /var/lib/keycloak-status
COPY status_publisher.py /opt/keycloak-status/status_publisher.py
COPY publisher_health_probe.py /opt/keycloak-status/publisher-health.py
USER 101:101
ENTRYPOINT ["python", "/opt/keycloak-status/status_publisher.py"]
CMD ["run"]
