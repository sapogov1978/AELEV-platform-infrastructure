# Overlay inputs, in addition to the existing .env.example settings.
# Give every role/replica a distinct COMPOSE_PROJECT, network/subnet and state volume.
# SQL server: server.crt, server.key, client-ca.crt. Never mount the server key in Keycloak.
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_SERVER_TLS_ROOT=./secrets/database-server
# Keycloak SQL client: ca.crt, client.p12 (alias user, explicitly empty PKCS12 password).
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_CLIENT_TLS_ROOT=./secrets/database-client
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_TLS_VOLUME=keycloak-database-instance-tls
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_BIND=127.0.0.1
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_HOST=database.identity.example.com
AELEV_INFRASTRUCTURE_KEYCLOAK_DATABASE_PORT=15432
# Management HTTPS is technical/operator-only; restrict it to the intended network.
AELEV_INFRASTRUCTURE_KEYCLOAK_MANAGEMENT_BIND=127.0.0.1
AELEV_INFRASTRUCTURE_KEYCLOAK_MANAGEMENT_PORT=19000
# Override the original UI_HEALTH_URL with this role's published HTTPS endpoint.
AELEV_INFRASTRUCTURE_KEYCLOAK_UI_HEALTH_URL=https://identity.example.com:19000/health/ready
